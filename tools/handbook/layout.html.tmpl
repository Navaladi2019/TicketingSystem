<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} - Nava handbook</title>
<link rel="stylesheet" href="{{.Prefix}}assets/handbook.css">
</head>
<body data-root="{{.Prefix}}">
<aside class="sidebar">
<a class="brand" href="{{.Prefix}}index.html">Nava handbook</a>
<div class="search"><input id="hb-q" type="search" placeholder="Search the handbook" autocomplete="off" aria-label="Search"><ul id="hb-results" hidden></ul></div>
<nav aria-label="Sections">
{{range .Nav}}<div class="nav-section"><a class="nav-title" href="{{if .Index}}{{.Index}}{{else}}#{{end}}">{{.Name}}</a>
<ul>{{range .Pages}}<li{{if .Current}} class="current"{{end}}><a href="{{.Href}}">{{.Title}}</a></li>{{end}}</ul></div>
{{end}}</nav>
</aside>
<main>
{{if .Crumbs}}<nav class="crumbs" aria-label="Breadcrumb">{{range .Crumbs}}<a href="{{.Href}}">{{.Title}}</a> / {{end}}<span>{{.Title}}</span></nav>{{end}}
{{if .Banner}}<p class="banner">Summary. The normative text is the linked <a href="{{.NormHref}}"><code>{{.NormPath}}</code></a>.</p>{{end}}
{{if .InProgress}}<p class="badge">In progress: not on main yet</p>{{end}}
<article>
<h1 class="page-title">{{.Title}}</h1>
{{.Body}}
</article>
{{if .Backlinks}}<section class="backlinks"><h2>Also named by</h2>
{{range .Backlinks}}<h3>{{.Label}}</h3><ul>{{range .Pages}}<li><a href="{{.Href}}">{{.Title}}</a></li>{{end}}</ul>
{{end}}</section>{{end}}
<footer><p class="hb-footer">{{.Stamp}}</p></footer>
</main>
<script src="{{.Prefix}}assets/search-index.js"></script>
{{if .HasMermaid}}<script src="{{.Prefix}}assets/mermaid.min.js"></script>
{{end}}<script src="{{.Prefix}}assets/handbook.js"></script>
</body>
</html>
