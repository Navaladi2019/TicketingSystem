# Go sources and config are LF on every checkout, so gofmt and golangci-lint
# agree on Windows (core.autocrlf=true) and Linux alike.
*.go     text eol=lf
go.mod   text eol=lf
go.sum   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
Makefile text eol=lf
make/*.mk text eol=lf
Taskfile.yml text eol=lf
# SQL migrations: checks match statement ends with `(?m);$`, which a CRLF
# checkout breaks (TICK-547, TestMigrationsHaveLFLineEndings).
*.sql    text eol=lf

# docs/ (ADRs, spike evidence) is kept byte-for-byte as recorded.
docs/**  -text
docs/go.mod text eol=lf

# Shared append-only tables: two stories that each append a row merge without a
# conflict (TICK-295, merge-safety D6). Union merge needs the files to be text,
# which `docs/** -text` above would otherwise turn off.
docs/delivery/todo.md            text eol=lf merge=union
docs/security/accepted-risks.md  text eol=lf merge=union
docs/pins.md                     text eol=lf merge=union
.gitignore                       text eol=lf merge=union

# Scripts that run in Linux containers.
*.sh     text eol=lf
Dockerfile text eol=lf
*.conf   text eol=lf
scripts/ci/pgbouncer/* text eol=lf

# Generated by `go generate ./api` (bundle + oapi-codegen); never hand-merge.
api/api.gen.go linguist-generated=true
api/openapi.bundled.yaml linguist-generated=true

# Recorded workflow histories (P3-23): byte-for-byte, so the append-only test's
# git hash-object matches the blob on main on every checkout.
internal/workflow/testdata/histories/** -text
# Golden vectors are compared byte for byte (TestVectorsFileIsCurrent).
internal/audit/chain/testdata/*.json text eol=lf
# CSV export fixtures have CRLF row ends and verbatim diff bytes, compared
# byte for byte (TestCSVFixturesAreCurrent).
internal/audit/verify/testdata/** -text

# The product handbook (TICK-719): the generator's output is compared byte for
# byte, so sources, viewer assets and generated files are LF on every checkout.
# The pinned Mermaid bundle is hashed against docs/pins.md, so it is never
# converted.
docs/handbook/** text eol=lf
docs/handbook/assets/mermaid.min.js -text
