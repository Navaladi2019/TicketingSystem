  "authenticatorConfig": [
    {
      "alias": "nava-deny-non-operator",
      "config": {
        "condUserRole": "nava-operator",
        "negate": "true"
      }
    }
  ],
  "authenticationFlows": [
    {
      "id": "00000000-0000-4000-8000-0000000000f1",
      "alias": "nava-operator-direct-grant",
      "description": "Direct grant for nava-operator-cli: only holders of nava-operator get a token (the audience mapper alone does not check the role).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "nava-operator-direct-grant-role-check",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "nava-operator-direct-grant-role-check",
      "description": "Deny unless the user holds nava-operator.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "nava-deny-non-operator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "nava-first-broker-login",
      "description": "ADR-001 A.1: create if unique, then add to the organization. No link, no confirm, no email verification.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-add-organization-member",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
