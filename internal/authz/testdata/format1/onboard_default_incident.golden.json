        "read",
        "write"
      ],
      "when": {
        "all": [
          {
            "any": [
              {
                "member_of": {
                  "groups": [
                    "22222222-2222-4222-8222-222222222222"
                  ]
                }
              }
            ]
          },
          {
            "cmp": {
