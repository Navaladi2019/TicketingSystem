{
  "format": "nava.workflow/v1",
  "trigger": { "on": "record.created", "entity": "ticket" },
  "start": "cool_off",
  "steps": [
    { "key": "cool_off", "type": "timer", "duration": "PT5S", "next": "is_high" },
    { "key": "is_high", "type": "condition", "field": "/priority", "op": "eq", "value": "critical", "then": "await_approval", "else": "done" },
    { "key": "await_approval", "type": "wait_signal", "name": "approve", "timeout": "P1D", "on_timeout": "done", "next": "mark_approved" },
    { "key": "mark_approved", "type": "update_record", "set": { "approved": true }, "next": "done" },
    { "key": "done", "type": "end" }
  ]
}
