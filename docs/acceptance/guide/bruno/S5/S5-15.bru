meta {
  name: S5.15 Restore: re-enable Alice
  type: http
  seq: 15
}

put {
  url: {{keycloak_url}}/admin/realms/{{realm}}/users/{{alice_kc_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{kc_admin_token}}
  Content-Type: application/json
}

body:json {
  {
    "enabled": true
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  await N.kcAdmin();
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 204', () => expect(res.getStatus()).to.eql(204));
  bru.setVar('change_at', String(Date.now()));
  bru.setVar('poll_n', 0);
}

docs {
  Undo S5.11.
}
