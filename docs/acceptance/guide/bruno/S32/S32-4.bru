meta {
  name: S32.4 Sign in as admin@tenant-b
  type: http
  seq: 4
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: nava-web
  scope: openid
  username: {{admin_b_username}}
  password: {{admin_b_password}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200 from Keycloak', () => expect(res.getStatus()).to.eql(200));
  const tok = N.json();
  test('access token issued', () => expect(tok.access_token).to.be.a('string'));
  bru.setVar('admin_b_token', tok.access_token);
  if (tok.id_token) bru.setVar('admin_b_token_id', tok.id_token);
  const c = N.jwt(tok.access_token);
  bru.setVar('admin_b_token_exp', String(c.exp));
  test('issuer is the pinned realm URL', () => expect(c.iss).to.eql(N.url('{{keycloak_issuer_url}}/realms/{{realm}}')));
}

docs {
  admin@tenant-b.test is seeded by `docs/acceptance/S18/tools/kit.mjs admin-b` (in organization tenant-b and `/t/<B>/admins`); `run.sh` runs it and one group sync.
}
