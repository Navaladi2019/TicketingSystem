meta {
  name: S32.36 AC4: naming another entity type's policy is refused at publish: 422
  type: http
  seq: 36
}

post {
  url: {{core_url}}/api/v1/workflow-definitions/s32_other_type/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick958-s32-{{s32_run}}-wf-mismatch
  Content-Type: application/json
}

body:json {
  {
    "format": "nava.workflow/v1",
    "trigger": {
      "on": "record.created",
      "entity": "incident"
    },
    "start": "check",
    "steps": [
      {
        "key": "check",
        "type": "condition",
        "policy": {
          "entity_type": "request",
          "name": "tenant_b_only"
        },
        "who": "assignee",
        "op": "write",
        "then": "triaged",
        "else": "needs_owner"
      },
      {
        "key": "triaged",
        "type": "update_record",
        "set": {
          "state": "triaged"
        },
        "next": "done"
      },
      {
        "key": "needs_owner",
        "type": "update_record",
        "set": {
          "state": "needs_owner"
        },
        "next": "done"
      },
      {
        "key": "done",
        "type": "end"
      }
    ]
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('workflow_definition_invalid', 422);
  test('entity_type_mismatch at the step\'s policy entity_type', () =>
    expect((N.json().errors || []).map(e => e.pointer + ' ' + e.rule)).to.include('/steps/check/policy/entity_type entity_type_mismatch'));
}

docs {
  A policy test may only name the trigger entity's own type (`entity_type_mismatch`), whichever tenant has a type of that key, so a workflow cannot reach any other type's policies. Nothing is published.
}
