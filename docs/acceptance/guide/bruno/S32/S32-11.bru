meta {
  name: S32.11 The admin reads the incident access policy
  type: http
  seq: 11
}

get {
  url: {{core_url}}/api/v1/entity-types/incident/access
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  bru.setVar('s32_policy', JSON.stringify(N.json()));
  bru.setVar('s32_etag', N.header('ETag'));
}

docs {
  Kept for S32.39, which republishes it.
}
