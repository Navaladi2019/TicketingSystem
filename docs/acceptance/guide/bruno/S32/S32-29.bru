}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  bru.setVar('s32_b_policy', JSON.stringify(N.json()));
  bru.setVar('s32_b_etag', N.header('ETag'));
}

docs {
