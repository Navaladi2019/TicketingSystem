meta {
  name: S32.38 Restore: admin@tenant-b republishes tenant B's access as S32.29 read it
  type: http
  seq: 38
}

put {
  url: {{core_url}}/api/v1/entity-types/incident/access
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_b_token}}
  Idempotency-Key: tick958-s32-{{s32_run}}-b-restore
  Content-Type: application/json
}

body:json {
  {
    "rules": "set by the pre-request script (built from this stack's group ids)"
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const cur = JSON.parse(bru.getVar('s32_b_policy'));
  req.setBody({ rules: cur.rules, masks: cur.masks });
  req.setHeader('If-Match', bru.getVar('s32_b_etag'));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('the S32.29 document', () => expect(N.json().rules).to.eql(JSON.parse(bru.getVar('s32_b_policy')).rules));
}
