meta {
  name: X3.10 nava-relay: GET /healthz
  type: http
  seq: 10
}

get {
  url: {{relay_admin_url}}/healthz
  body: none
  auth: none
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const b = N.json();
  test('status ok', () => expect(b.status).to.eql('ok'));
  test('every check ok', () => Object.entries(b.checks || {}).forEach(([k, s]) => expect(s, k).to.eql('ok')));
}

docs {
  nava-relay's admin listener (:9090) through `tools/tunnels.sh up`. `status` ok and every check ok.
}
