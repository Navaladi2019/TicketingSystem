meta {
  name: S18T.4 Read the zone: 200
  type: http
  seq: 4
}

get {
  url: {{core_url}}/api/v1/tenant/settings/time-zone
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200, Europe/Berlin', () => {
    expect(res.getStatus()).to.eql(200);
    expect(N.json().time_zone).to.eql('Europe/Berlin');
  });
  N.status(200);
}
