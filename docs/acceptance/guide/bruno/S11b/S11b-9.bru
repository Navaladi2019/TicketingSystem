meta {
  name: S11b.9 A field reference as a duration: 422
  type: http
  seq: 9
}

post {
  url: {{core_url}}/api/v1/workflow-definitions/{{s11b_key}}/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick710-s11b-{{s11b_run}}-dur
  Content-Type: application/json
}

body:json {
  {
    "format": "nava.workflow/v1",
    "trigger": {
      "on": "record.created",
      "entity": "incident"
    },
    "start": "wait",
    "steps": [
      {
        "key": "wait",
        "type": "timer",
        "duration": "/due_in",
        "next": "mark"
      },
      {
        "key": "mark",
        "type": "update_record",
        "set": {
          "short_description": "triaged"
        },
        "next": "done"
      },
      {
        "key": "done",
        "type": "end"
      }
    ]
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('workflow_definition_invalid', 422);
  test('the step is named and no value is echoed', () => {
    expect(N.json().errors.map(e => e.pointer).join(' ')).to.include('/steps/wait');
    expect(JSON.stringify(N.json())).to.not.include('due_in');
  });
}
