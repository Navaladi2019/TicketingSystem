meta {
  name: S11b.10 Alice (not an admin) publishes: 403
  type: http
  seq: 10
}

post {
  url: {{core_url}}/api/v1/workflow-definitions/{{s11b_key}}/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: tick710-s11b-{{s11b_run}}-alice
  Content-Type: application/json
}

body:json {
  {
    "format": "nava.workflow/v1",
    "trigger": {
      "on": "record.created",
      "entity": "incident"
    },
    "start": "wait",
    "steps": [
      {
        "key": "wait",
        "type": "timer",
        "duration": "PT1H",
        "next": "mark"
      },
      {
        "key": "mark",
        "type": "update_record",
        "set": {
          "short_description": "triaged"
        },
        "next": "done"
      },
      {
        "key": "done",
        "type": "end"
      }
    ]
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('forbidden', 403);
}
