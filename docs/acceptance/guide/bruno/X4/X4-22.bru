meta {
  name: X4.22 getEntityTypeVersion 404: a version that does not exist
  type: http
  seq: 22
}

get {
  url: {{core_url}}/api/v1/entity-types/{{x4_type}}/versions/2
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json with code not_found and no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    const b = N.json();
    expect(b.code).to.eql('not_found');
    expect(b).to.not.have.property('instance');
  });
  N.status(404);
}

docs {
  Only version 1 exists.
}
