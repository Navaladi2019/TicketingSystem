meta {
  name: X4.8 createEntityType 422: a definition that does not compile
  type: http
  seq: 8
}

post {
  url: {{core_url}}/api/v1/entity-types
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: {{x4_key3}}
  Content-Type: application/json
}

body:json {
  {
    "key": "{{x4_type}}",
    "name": "Acceptance type",
    "number_prefix": "{{x4_prefix}}",
    "definition": {
      "schema": {
        "type": "array"
      },
      "fixed_columns": {},
      "states": {}
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_definition', 422);
  test('a /definition/ pointer', () => expect((N.json().errors || []).some(e => e.pointer.startsWith('/definition'))).to.eql(true));
}

docs {
  The schema root must be an object schema; the pointer is under `/definition`.
}
