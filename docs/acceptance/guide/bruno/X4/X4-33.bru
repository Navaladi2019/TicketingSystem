meta {
  name: X4.33 publishEntityTypeVersion 412: a stale If-Match
  type: http
  seq: 33
}

post {
  url: {{core_url}}/api/v1/entity-types/{{x4_type}}/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick673-412-{{x4_key4}}
  If-Match: W/"1"
  Content-Type: application/json
}

body:json {
  {
    "definition": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short_description",
          "state"
        ],
        "properties": {
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "closed"
            ],
            "default": "new"
          }
        },
        "description": "published by X4.30"
      },
      "fixed_columns": {
        "state": "state"
      },
      "states": {
        "initial": "new",
        "states": [
          "new",
          "closed"
        ],
        "transitions": [
          {
            "from": "new",
            "to": "closed"
          }
        ]
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('version_conflict', 412);
}

docs {
  `If-Match` is optional; sent, it must name the current version (2 after X4.30). Nothing is written and the current `ETag` is in the header (TICK-673).
}
