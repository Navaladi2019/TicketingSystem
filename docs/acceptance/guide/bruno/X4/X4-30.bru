meta {
  name: X4.30 publishEntityTypeVersion 201: version 2
  type: http
  seq: 30
}

post {
  url: {{core_url}}/api/v1/entity-types/{{x4_type}}/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: {{x4_key6}}
  Content-Type: application/json
}

body:json {
  {
    "definition": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short_description",
          "state"
        ],
        "properties": {
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "closed"
            ],
            "default": "new"
          }
        },
        "description": "published by X4.30"
      },
      "fixed_columns": {
        "state": "state"
      },
      "states": {
        "initial": "new",
        "states": [
          "new",
          "closed"
        ],
        "transitions": [
          {
            "from": "new",
            "to": "closed"
          }
        ]
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  const b = N.json();
  test('version 2, current, compatible', () => {
    expect(b.version).to.eql(2);
    expect(b.current).to.eql(true);
    expect(b.compat).to.eql('compatible');
  });
}

docs {
  A new `description` is Compatible. The response is version 2, current.
}
