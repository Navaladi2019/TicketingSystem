meta {
  name: X4.32 publishEntityTypeVersion 404: an unknown key
  type: http
  seq: 32
}

post {
  url: {{core_url}}/api/v1/entity-types/no_such_type_x4/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: {{x4_key7}}
  Content-Type: application/json
}

body:json {
  {
    "definition": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short_description",
          "state"
        ],
        "properties": {
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "closed"
            ],
            "default": "new"
          }
        },
        "description": "published by X4.30"
      },
      "fixed_columns": {
        "state": "state"
      },
      "states": {
        "initial": "new",
        "states": [
          "new",
          "closed"
        ],
        "transitions": [
          {
            "from": "new",
            "to": "closed"
          }
        ]
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json with code not_found and no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    const b = N.json();
    expect(b.code).to.eql('not_found');
    expect(b).to.not.have.property('instance');
  });
  N.status(404);
}

docs {
  404 `not_found` with no `instance`.
}
