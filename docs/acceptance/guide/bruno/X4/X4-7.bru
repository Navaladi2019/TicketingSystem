meta {
  name: X4.7 createEntityType 422: key and prefix rejected
  type: http
  seq: 7
}

post {
  url: {{core_url}}/api/v1/entity-types
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: {{x4_key2}}
  Content-Type: application/json
}

body:json {
  {
    "key": "Bad Key",
    "name": "Acceptance type",
    "number_prefix": "x",
    "definition": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short_description",
          "state"
        ],
        "properties": {
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "closed"
            ],
            "default": "new"
          }
        }
      },
      "fixed_columns": {
        "state": "state"
      },
      "states": {
        "initial": "new",
        "states": [
          "new",
          "closed"
        ],
        "transitions": [
          {
            "from": "new",
            "to": "closed"
          }
        ]
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_definition', 422);
  N.fieldError('/key');
  N.fieldError('/number_prefix');
}

docs {
  Malformed `key` and `number_prefix`: `errors[].pointer` names each.
}
