meta {
  name: X4.6 createEntityType 403: a user who is not an admin
  type: http
  seq: 6
}

post {
  url: {{core_url}}/api/v1/entity-types
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: {{x4_key}}
  Content-Type: application/json
}

body:json {
  {
    "key": "{{x4_type}}",
    "name": "Acceptance type",
    "number_prefix": "{{x4_prefix}}",
    "definition": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short_description",
          "state"
        ],
        "properties": {
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "closed"
            ],
            "default": "new"
          }
        }
      },
      "fixed_columns": {
        "state": "state"
      },
      "states": {
        "initial": "new",
        "states": [
          "new",
          "closed"
        ],
        "transitions": [
          {
            "from": "new",
            "to": "closed"
          }
        ]
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('forbidden', 403);
}

docs {
  The admin check runs before the body is read, so even a bad body gets 403.
}
