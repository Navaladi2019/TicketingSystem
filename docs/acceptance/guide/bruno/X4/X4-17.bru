meta {
  name: X4.17 getEntityType 200: the current version
  type: http
  seq: 17
}

get {
  url: {{core_url}}/api/v1/entity-types/{{x4_type}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('version 1 of the type', () => {
    expect(N.json().key).to.eql(bru.getVar('x4_type'));
    expect(N.json().schema_sha256).to.eql(bru.getVar('x4_sha'));
  });
}

docs {
  Any tenant user.
}
