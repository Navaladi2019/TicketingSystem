meta {
  name: S18N.30 AC5: a made-up format id gives the same 422
  type: http
  seq: 30
}

post {
  url: {{core_url}}/api/v1/entity-types/incident/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_b_token}}
  Idempotency-Key: s18n-{{s18n_run}}-b-ghost
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const tok = bru.getVar('admin_b_token');
  const cur = await N.send({ url: N.url('{{core_url}}/api/v1/entity-types/incident'), method: 'GET', headers: { Authorization: 'Bearer ' + tok } });
  if (cur.status !== 200) throw new Error('GET incident: HTTP ' + cur.status);
  bru.setVar('s18n_cur_incident', String(cur.data.version));
  req.setBody({ definition: { schema: cur.data.schema, fixed_columns: cur.data.fixed_columns, states: cur.data.states }, number_format: { id: '00000000-0000-4000-8000-00000000f18f', version: 1 } });
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('number_format_not_found', 422);
  test('the same detail and errors as for tenant A\'s format', () => expect(JSON.stringify({ detail: N.json().detail, errors: N.json().errors })).to.eql(bru.getVar('s18n_422_a')));
}
