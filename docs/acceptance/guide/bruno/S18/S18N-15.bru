meta {
  name: S18N.15 AC1: VISA0000002 keeps its number (agent@tenant-a reads it)
  type: http
  seq: 15
}

get {
  url: {{core_url}}/api/v1/records/visa/{{s18_visa2_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const want = 'VISA0000002';
  test(`number still ${want}`, () => expect(N.json().number).to.eql(want));
}
