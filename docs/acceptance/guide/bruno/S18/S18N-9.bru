meta {
  name: S18N.9 AC1: admin@tenant-a links the format to the Visa type
  type: http
  seq: 9
}

post {
  url: {{core_url}}/api/v1/entity-types/visa/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: s18n-{{s18n_run}}-link
  Content-Type: application/json
}

body:json {
  {
    "definition": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short_description",
          "state"
        ],
        "properties": {
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "closed"
            ],
            "default": "new"
          }
        }
      },
      "fixed_columns": {
        "state": "state"
      },
      "states": {
        "initial": "new",
        "states": [
          "new",
          "closed"
        ],
        "transitions": [
          {
            "from": "new",
            "to": "closed"
          }
        ]
      }
    },
    "number_format": {
      "id": "{{s18n_visa_fmt}}",
      "version": 1
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  test('version 2 pins the format, version 1', () => {
    expect(N.json().version).to.eql(2);
    expect(N.json().number_format).to.eql({ id: bru.getVar('s18n_visa_fmt'), version: 1 });
  });
}

docs {
  `number_format` `{id, version}` with the same definition. The format cannot render a default number (`VISA` then 7 digits), so the publish takes a new epoch.
}
