meta {
  name: S18N.27 AC5: admin@tenant-b reads tenant A's format: 404
  type: http
  seq: 27
}

get {
  url: {{core_url}}/api/v1/number-formats/{{s18n_visa_fmt}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_b_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json, code not_found, no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  N.status(404);
  bru.setVar('s18n_404_a', N.text());
  N.noLeak(bru.getVar('s18n_visa_fmt'), '{yyyy}');
}
