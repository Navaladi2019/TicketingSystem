meta {
  name: S18N.25 AC4: VISA0000001 keeps its number
  type: http
  seq: 25
}

get {
  url: {{core_url}}/api/v1/records/visa/{{s18_visa1_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const want = 'VISA0000001';
  test(`number still ${want}`, () => expect(N.json().number).to.eql(want));
}
