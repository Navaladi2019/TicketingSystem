}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('no entries', () => expect(N.json().items).to.eql([]));
}

docs {
  The same filter as S18N.36, as tenant B's admin. The tenant comes from the token, so tenant A's entry is not there.
