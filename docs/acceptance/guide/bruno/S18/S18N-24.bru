meta {
  name: S18N.24 AC4: the first formatted ticket keeps its number
  type: http
  seq: 24
}

get {
  url: {{core_url}}/api/v1/records/visa/{{s18n_visa1_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const want = bru.getVar('s18n_visa1_number');
  test(`number still ${want}`, () => expect(N.json().number).to.eql(want));
}
