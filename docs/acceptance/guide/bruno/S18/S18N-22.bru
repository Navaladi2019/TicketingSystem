meta {
  name: S18N.22 AC4: admin@tenant-a publishes an unrelated change to the Visa type (adds a field)
  type: http
  seq: 22
}

post {
  url: {{core_url}}/api/v1/entity-types/visa/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: s18n-{{s18n_run}}-addfield
  Content-Type: application/json
}

body:json {
  {
    "definition": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "short_description",
          "state"
        ],
        "properties": {
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "closed"
            ],
            "default": "new"
          },
          "passport_no": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "fixed_columns": {
        "state": "state"
      },
      "states": {
        "initial": "new",
        "states": [
          "new",
          "closed"
        ],
        "transitions": [
          {
            "from": "new",
            "to": "closed"
          }
        ]
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  test('version 3, compatible, still pins the format version 1', () => {
    expect(N.json().version).to.eql(3);
    expect(N.json().compat).to.eql('compatible');
    expect(N.json().schema.properties).to.have.property('passport_no');
    expect(N.json().number_format).to.eql({ id: bru.getVar('s18n_visa_fmt'), version: 1 });
  });
}

docs {
  No `number_format` field: the publish keeps the pinned format.
}
