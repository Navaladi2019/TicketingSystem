meta {
  name: S18N.4 admin@tenant-b is tenant B's admin
  type: http
  seq: 4
}

get {
  url: {{core_url}}/api/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_b_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.me('00000000-0000-4000-8000-0000000000b1');
  test('in /admins', () => expect(N.paths()).to.include('/admins'));
}

docs {
  run-kit.sh seeded admin@tenant-b.test into tenant B's admins group.
}
