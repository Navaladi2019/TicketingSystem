meta {
  name: S30.17 AC5 before: Alice opens the admins incident
  type: http
  seq: 17
}

get {
  url: {{core_url}}/api/v1/records/incident/{{s30_adm}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(404);
  test('problem+json, code not_found, no instance', () => {
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  test('body byte-identical to the missing id\'s 404', () => expect(N.text()).to.eql(bru.getVar('s30_ref404')));
  bru.setVar('s30_f1_a_adm', JSON.stringify({ status: res.getStatus(), body: res.getStatus() === 404 ? N.text() : null }));
}
