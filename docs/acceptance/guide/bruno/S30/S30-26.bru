meta {
  name: S30.26 AC5 after: the requester opens its /service-desk incident
  type: http
  seq: 26
}

get {
  url: {{core_url}}/api/v1/records/incident/{{s30_sd_other}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{req_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  const was = JSON.parse(bru.getVar('s30_f1_r_other'));
  test('the same status as before the upgrade (' + was.status + ')', () => expect(res.getStatus()).to.eql(was.status));
  if (was.status === 404) test('the same 404 bytes as before', () => expect(N.text()).to.eql(was.body));
}
