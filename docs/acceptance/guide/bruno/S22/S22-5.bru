meta {
  name: S22.5 AC3: Alice's priority filters on the seed type answer through the index, the same rows as before
  type: http
  seq: 5
}

get {
  url: {{core_url}}/api/v1/records/incident?filter[priority]=1&limit=200
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/kit')(N, bru);
  // The seed type's own backfill (its few seeded records) is done within seconds of the stack start.
  const ss = await T.until(async () => { const r = await T.list('alice_token', 'incident', 'filter[priority]=1&limit=1'); return { status: r.status }; },
                           s => s.status !== 422, { every: 2000, limit: 120000 });
  // The reference: every incident Alice may read, unfiltered, checked here in JS.
  const every = await T.all('alice_token', 'incident', 'sort=created_at');
  const out = { ready: ss, every: every.items.map(i => ({ id: i.id, priority: i.data.priority })) };
  for (const q of ['filter[priority]=1', 'filter[priority][in]=1,2', 'filter[priority][gte]=3']) {
    const r = await T.all('alice_token', 'incident', q);
    out[q] = { status: r.status, ids: r.ids, broken: r.broken };
  }
  bru.setVar('s22_ac3', JSON.stringify(out));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const o = JSON.parse(bru.getVar('s22_ac3'));
  test('priority on the seed type is ready (never 422 after the start-up backfill)', () => expect(o.ready[o.ready.length - 1].status).to.eql(200));
  const want = (f) => o.every.filter(r => f(r.priority)).map(r => r.id).sort();
  [['filter[priority]=1', p => p === 1], ['filter[priority][in]=1,2', p => p === 1 || p === 2], ['filter[priority][gte]=3', p => p >= 3]].forEach(([q, f]) => {
    test(`${q}: 200, exactly the incidents a full read filtered in JS gives (${want(f).length})`, () => {
      expect(o[q].status).to.eql(200);
      expect([...o[q].ids].sort()).to.eql(want(f));
      expect(o[q].broken).to.eql([]);
    });
  });
}

docs {
  Before S22 these filters ran as a JSONB scan on the seed types (`store.DataFilterTimeout` bounded it); now they read the side tables. Each filter the earlier kits use on `priority` (equality, `in`, a range) gives Alice exactly the incidents a plain read of everything she may see gives when filtered in the test. The static half of AC3 (the scan path and `DataFilterTimeout` are gone from the code) is run-kit.sh's `git grep` step.
}
