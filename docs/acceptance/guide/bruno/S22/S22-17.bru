meta {
  name: S22.17 AC2: the tenant admin cannot raise its own limit
  type: http
  seq: 17
}

put {
  url: {{onboard_url}}/api/v1/operator/tenants/00000000-0000-4000-8000-0000000000a1/limits
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: s22-{{s22_run}}-limit-admin
  Content-Type: application/json
}

body:json {
  {
    "filterable_fields_per_type": 10,
    "reason": "S22 kit: a tenant admin tries"
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('refused: 401 or 403', () => expect([401, 403]).to.include(res.getStatus()));
}

docs {
  The operator API (nava-onboard, through `tools/tunnels.sh up`) refuses a tenant token: 401 `invalid_token` (the audience is `nava-api`, not `nava-operator-api`), or 403. Nothing is written: S22.21's publish of the sixth flag would otherwise not need S22.19.
}
