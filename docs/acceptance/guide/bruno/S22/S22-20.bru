meta {
  name: S22.20 AC2: the same raise again is a replay: 200, still 10
  type: http
  seq: 20
}

put {
  url: {{onboard_url}}/api/v1/operator/tenants/00000000-0000-4000-8000-0000000000a1/limits
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: s22-{{s22_run}}-limit-10
  Content-Type: application/json
}

body:json {
  {
    "filterable_fields_per_type": 10,
    "reason": "S22 acceptance: measured cost check (TICK-754)"
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('still 10', () => expect(N.json().filterable_fields_per_type).to.eql(10));
}

docs {
  The same `Idempotency-Key`: the stored answer, and no second audit entry (verify.sql counts exactly one).
}
