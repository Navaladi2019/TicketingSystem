meta {
  name: S22.24 AC2: after the raise, the sixth flag publishes: 201
  type: http
  seq: 24
}

post {
  url: {{core_url}}/api/v1/entity-types/{{s22_qkey}}/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: s22-{{s22_run}}-quota-6th-after
  Content-Type: application/json
}

body:json {
  {
    "definition": "set by the pre-request script"
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const d = JSON.parse(bru.getVar('s22_qdef'));
  d.schema.properties.q6['x-nava-filterable'] = true;
  req.setBody({ definition: d });
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  test('version 2, q6 flagged', () => { expect(N.json().version).to.eql(2); expect(N.json().schema.properties.q6['x-nava-filterable']).to.eql(true); });
}

docs {
  The same definition S22.16 sent, with a new `Idempotency-Key`: the tenant's limit is now 10 per type, so 6 flagged fields publish.
}
