meta {
  name: X1.11 getMe 401: Alice's token rewritten to tenant B (wrong tenant)
  type: http
  seq: 11
}

get {
  url: {{core_url}}/api/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{wrongtenant_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  bru.setVar('wrongtenant_token', N.rewrite(bru.getVar('alice_token'), c => { c.organization = { 'tenant-b': { id: '00000000-0000-4000-8000-0000000000b1' } }; }));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_token', 401);
  N.noLeak('00000000-0000-4000-8000-0000000000b1');
}

docs {
  The only way to name another tenant in a token is to change it, which breaks the signature.
}
