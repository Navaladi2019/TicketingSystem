meta {
  name: S17.7 AC1: the first incident after the upgrade on the gaps type is INC0000043
  type: http
  seq: 7
}

post {
  url: {{core_url}}/api/v1/records/incident
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bob_token}}
  Idempotency-Key: s17-{{s17_run}}-b43
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "S17 {{s17_run}} gaps first after the upgrade"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  const b = N.json();
  test('number INC0000043', () => expect(b.number).to.eql('INC0000043'));
  bru.setVar('s17_b43_id', b.id);
  console.log('S17.7 tenant B (gaps):', b.number, b.id);
}

docs {
  Bob creates an incident in tenant B, whose type is `gaps`: the allocator takes the number outside the create transaction (L2s), on the same counter row.
}
