meta {
  name: S17.14 Isolation: tenant A's creates did not move tenant B's counter
  type: http
  seq: 14
}

post {
  url: {{core_url}}/api/v1/records/incident
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bob_token}}
  Idempotency-Key: s17-{{s17_run}}-b-after
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "S17 {{s17_run}} gaps after tenant A's creates"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  const inc = (n) => 'INC' + String(n).padStart(7, '0');
  const num = (s) => Number(String(s).slice(3));
  N.status(201);
  const want = inc(Number(bru.getVar('s17_max_b')) + 1);
  test(`number ${want}: the next of tenant B's own series`, () => expect(N.json().number).to.eql(want));
}

docs {
  Tenant A made 10 creates since S17.7. Tenant B's next number is the one after its own last (S17.10); no B create failed, so none was skipped.
}
