meta {
  name: S17.11 Isolation: Bob reads tenant A's INC0000043: 404
  type: http
  seq: 11
}

get {
  url: {{core_url}}/api/v1/records/incident/{{s17_a43_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{bob_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json with code not_found and no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    const b = N.json();
    expect(b.code).to.eql('not_found');
    expect(b).to.not.have.property('instance');
  });
  N.noLeak('INC0000043', bru.getVar('s17_a43_id'), 'S17 ' + bru.getVar('s17_run') + ' gapless');
}

docs {
  Tenant A's record id from tenant B's token: the same 404 as a record that does not exist, naming nothing of tenant A.
}
