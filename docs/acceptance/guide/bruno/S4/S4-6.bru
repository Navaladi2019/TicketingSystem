meta {
  name: S4.6 Negative: no Idempotency-Key
  type: http
  seq: 6
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{onb_domain}}",
    "email_domains": [
      "{{onb_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('validation_failed', 400);
  test('errors[] has a pointer', () => expect(N.json().errors[0]).to.have.property('pointer'));
}

docs {
  The header is required. `errors` names the failing field and never echoes input.
}
