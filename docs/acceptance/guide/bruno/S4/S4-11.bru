meta {
  name: S4.11 Negative: another tenant claims the same domain
  type: http
  seq: 11
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{onb_key}}-dup
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{onb_domain}}",
    "email_domains": [
      "{{onb_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('domain_claimed', 409);
  N.noLeak(bru.getVar('onb_tenant_id'), bru.getVar('onb_domain'));
}

docs {
  A new key with the S4.8 domain: 409 `domain_claimed`. The body names neither the owning tenant nor the domain.
}
