meta {
  name: S4.9 Replay: same key, same body
  type: http
  seq: 9
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{onb_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{onb_domain}}",
    "email_domains": [
      "{{onb_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200 (a replay)', () => expect(res.getStatus()).to.eql(200));
  test('byte-identical body', () => expect(N.text()).to.eql(bru.getVar('onb_body')));
}

docs {
  200 with a byte-identical body. Nothing new is created.
}
