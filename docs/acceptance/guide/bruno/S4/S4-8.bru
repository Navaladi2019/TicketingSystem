meta {
  name: S4.8 Onboard a new tenant
  type: http
  seq: 8
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{onb_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{onb_domain}}",
    "email_domains": [
      "{{onb_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  const b = N.json();
  test('tenant_id is a uuid, state active', () => {
    expect(b.tenant_id).to.match(/^[0-9a-f-]{36}$/);
    expect(b.state).to.eql('active');
  });
  bru.setVar('onb_tenant_id', b.tenant_id);
  bru.setVar('onb_body', N.text());
}

docs {
  201 with the server-derived tenant id and `state: active`. Creates the Keycloak organization and IdP, the binding, the domain claim and a pending invite for the admin.
}
