meta {
  name: S4.5 Negative: the operator route on the tenant ingress (nava-core)
  type: http
  seq: 5
}

post {
  url: {{core_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{onb_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{onb_domain}}",
    "email_domains": [
      "{{onb_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('not_implemented', 501);
}

docs {
  nava-core never holds the onboarding credentials: it answers the operator route 501.
}
