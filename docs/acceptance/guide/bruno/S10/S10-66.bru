meta {
  name: S10.66 The admin removes the masks again: 200, the rules unchanged
  type: http
  seq: 66
}

put {
  url: {{core_url}}/api/v1/entity-types/incident/access
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick623-s10-{{s10_run}}-unmask
  Content-Type: application/json
}

body:json {
  {
    "rules": []
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const cur = JSON.parse(bru.getVar('s10_policy'));
  req.setBody({ rules: cur.rules, masks: [] });
  req.setHeader('If-Match', bru.getVar('s10_etag_mask'));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const was = JSON.parse(bru.getVar('s10_policy'));
  test('version + 1', () => expect(N.json().version).to.eql(Number(bru.getVar('s10_mask_version')) + 1));
  test("S10.10's rules, no masks", () => {
    expect(N.json().rules).to.eql(was.rules);
    expect(N.json().masks).to.eql([]);
  });
}

docs {
  Republishes S10.10's rules with `masks: []`, so later folders and the next pass start unmasked, even after a pass that stopped between S10.31 and here.
}
