meta {
  name: S10.43 A3: the requester edits its own new incident: 200
  type: http
  seq: 43
}

patch {
  url: {{core_url}}/api/v1/records/incident/{{s10_req_rec}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{req_a_token}}
  Idempotency-Key: tick623-s10-{{s10_run}}-req-edit
  Content-Type: application/merge-patch+json
  If-Match: W/"1"
}

body:json {
  {
    "data": {
      "priority": 2
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('version 2', () => expect(N.json().version).to.eql(2));
}

docs {
  `default-requester-new`: read and write while `state` is `new`.
}
