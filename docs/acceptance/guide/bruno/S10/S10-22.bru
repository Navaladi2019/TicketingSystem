meta {
  name: S10.22 PUT for an unknown entity type: 404
  type: http
  seq: 22
}

put {
  url: {{core_url}}/api/v1/entity-types/no_such_type/access
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick620-s10-{{s10_run}}-nosuch
  If-Match: W/"0"
  Content-Type: application/json
}

body:json {
  {
    "rules": []
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json, code not_found, no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  N.status(404);
}
