meta {
  name: S10.6 The admin reads the incident access policy: 200 with its ETag
  type: http
  seq: 6
}

get {
  url: {{core_url}}/api/v1/entity-types/incident/access
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const b = N.json();
  test('version, rules, masks, published_at', () => {
    expect(b.version).to.be.a('number');
    expect(b.rules).to.be.an('array');
    expect(b.masks).to.be.an('array');
    expect(b.published_at).to.be.a('string');
  });
  test('ETag W/"<version>"', () => expect(N.header('ETag')).to.eql('W/"' + b.version + '"'));
  bru.setVar('s10_policy', JSON.stringify(b));
}

docs {
  The newest published version, `{version, rules, masks, published_by, published_at}`, with `ETag: W/"<version>"`. On a fresh stack it is version 1, the default incident ACL, with `published_by` null.
}
