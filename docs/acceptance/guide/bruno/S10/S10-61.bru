meta {
  name: S10.61 C5: explain (Alice, /service-desk incident): allow by default-service-desk, description masked
  type: http
  seq: 61
}

get {
  url: {{core_url}}/api/v1/access/explain?entity=incident&record={{s10_sd_rec}}&user={{s10_alice}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const b = N.json();
  test('decision allow', () => expect(b.decision).to.eql('allow'));
  test('rule_id default-service-desk', () => expect(b.rule_id).to.eql('default-service-desk'));
  test('acl_version is the masked version', () => expect(b.acl_version).to.eql(Number(bru.getVar('s10_mask_version'))));
  test('masked_fields: description', () => expect(b.masked_fields).to.eql(['description']));
}
