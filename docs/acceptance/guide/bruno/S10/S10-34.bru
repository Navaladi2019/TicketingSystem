meta {
  name: S10.34 The admin creates an incident assigned to admins
  type: http
  seq: 34
}

post {
  url: {{core_url}}/api/v1/records/incident
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick623-s10-{{s10_run}}-adm
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "S10 {{s10_run}} admins",
      "assignment_group": "{{s10_admins}}"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  bru.setVar('s10_adm_rec', N.json().id);
}

docs {
  Assigned to a group Alice is not in: outside her rules.
}
