meta {
  name: S10.65 C5: explain (requester, its in_progress incident): allow by default-requester
  type: http
  seq: 65
}

get {
  url: {{core_url}}/api/v1/access/explain?entity=incident&record={{s10_req2_rec}}&user={{s10_requester}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const b = N.json();
  test('decision allow', () => expect(b.decision).to.eql('allow'));
  test('rule_id default-requester', () => expect(b.rule_id).to.eql('default-requester'));
  test('acl_version is the masked version', () => expect(b.acl_version).to.eql(Number(bru.getVar('s10_mask_version'))));
}
