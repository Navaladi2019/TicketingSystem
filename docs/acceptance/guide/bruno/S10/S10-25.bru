meta {
  name: S10.25 Alice (not an admin) publishes: 403, nothing published
  type: http
  seq: 25
}

put {
  url: {{core_url}}/api/v1/entity-types/incident/access
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: tick620-s10-{{s10_run}}-alice
  If-Match: W/"1"
  Content-Type: application/json
}

body:json {
  {
    "rules": []
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('forbidden', 403);
}

docs {
  Only tenant admins publish. The admin check runs first, so Alice learns nothing about the version or the body.
}
