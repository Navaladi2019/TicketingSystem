meta {
  name: S10.16 An unknown column and a group of no tenant: 422 with pointers
  type: http
  seq: 16
}

put {
  url: {{core_url}}/api/v1/entity-types/incident/access
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick620-s10-{{s10_run}}-bad
  If-Match: W/"0"
  Content-Type: application/json
}

body:json {
  {
    "rules": [
      {
        "id": "bad",
        "ops": [
          "read"
        ],
        "who": {
          "groups": [
            "00000000-0000-4000-8000-00000000dead"
          ]
        },
        "where": [
          {
            "column": "priority",
            "op": "eq",
            "values": [
              "1"
            ]
          }
        ]
      }
    ]
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_access_policy', 422);
  const at = N.json().errors.map(e => e.pointer);
  test('the column is named', () => expect(at).to.include('/rules/0/where/0/column'));
}

docs {
  422 `invalid_access_policy`. The unknown column is refused at `/rules/0/where/0/column`. A group that is not in the tenant is refused at `/rules/0/who/groups/0`, the same whether it does not exist or belongs to another tenant. The shape is checked before the version, so this answers 422, not 412.
}
