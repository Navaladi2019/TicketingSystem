meta {
  name: S10.45 C3: Alice opens an id that does not exist: 404
  type: http
  seq: 45
}

get {
  url: {{core_url}}/api/v1/records/incident/00000000-0000-4000-8000-00000000dead
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(404);
  test('problem+json, code not_found, no instance', () => {
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  bru.setVar('s10_ref404_alice', N.text());
}

docs {
  The reference 404 for S10.46 to S10.49.
}
