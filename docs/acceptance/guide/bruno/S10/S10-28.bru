meta {
  name: S10.28 Sign in as requester@tenant-a (seeded auditor@tenant-a.test)
  type: http
  seq: 28
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: nava-web
  scope: openid
  username: {{auditor_a_username}}
  password: {{auditor_a_password}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200 from Keycloak', () => expect(res.getStatus()).to.eql(200));
  const tok = N.json();
  test('access token issued', () => expect(tok.access_token).to.be.a('string'));
  bru.setVar('req_a_token', tok.access_token);
  if (tok.id_token) bru.setVar('req_a_token_id', tok.id_token);
  const c = N.jwt(tok.access_token);
  bru.setVar('req_a_token_exp', String(c.exp));
  test('issuer is the pinned realm URL', () => expect(c.iss).to.eql(N.url('{{keycloak_issuer_url}}/realms/{{realm}}')));
}

docs {
  The story's `requester@tenant-a` is the seeded `auditor@tenant-a.test`: a tenant A user in neither `/service-desk` nor `admins`, so only the requester rules can admit it. Its `audit.read` plays no part in record reads.
}
