meta {
  name: S10.13 The admin creates an incident for Alice as requester
  type: http
  seq: 13
}

post {
  url: {{core_url}}/api/v1/records/incident
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick620-s10-{{s10_run}}-create
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "S10 {{s10_run}} explainer",
      "requester": "{{s10_alice}}"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  bru.setVar('s10_rec', N.json().id);
}

docs {
  The admin has write on every record under the default ACL; Alice is named as the requester.
}
