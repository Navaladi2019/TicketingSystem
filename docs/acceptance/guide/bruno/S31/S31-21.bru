meta {
  name: S31.21 AC1: agent-emea lists exactly the EMEA and EMEA/Germany tickets
  type: http
  seq: 21
}

get {
  url: {{core_url}}/api/v1/records/incident?limit=200
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{s31_agent_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const ids = N.json().items.map(i => i.id);
  test('includes s31_t_emea', () => expect(ids).to.include(bru.getVar('s31_t_emea')));
  test('includes s31_t_de', () => expect(ids).to.include(bru.getVar('s31_t_de')));
  test('leaves out s31_t_apac', () => expect(ids).to.not.include(bru.getVar('s31_t_apac')));
  test('leaves out s31_t_none', () => expect(ids).to.not.include(bru.getVar('s31_t_none')));
  test('total is the number of items (one page, no cursor)', () => {
    expect(N.json().next_cursor, 'one page on a fresh stack').to.eql(null);
    expect(N.json().total).to.eql(N.json().items.length);
  });
  test('every item was raised by s31_req_emea or s31_req_de', () => N.json().items.forEach(i => expect([bru.getVar('s31_req_emea'), bru.getVar('s31_req_de')]).to.include(i.data.requester)));
  console.log('S31.21: total', N.json().total);
}

docs {
  The region is EMEA and every unit below it. `total` is counted under the same rule, so it is the number of listed items.
}
