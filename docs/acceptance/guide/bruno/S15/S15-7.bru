meta {
  name: S15.7 AC1: the first incident's entry is sealed
  type: http
  seq: 7
}

get {
  url: {{core_url}}/api/v1/audit/entries?subject_id={{s15_rec1}}&limit=10
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{auditor_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  await require('./lib/s15')(N, bru).fresh();
  // Polls, once a second, until the entry has a seq, for up to 330 s; this
  // request then reads the sealed entry.
  const t0 = Date.now();
  const T = require('./lib/s15')(N, bru);
  for (;;) {
    await T.fresh('auditor_token');
    const r = await N.send({
      url: N.url('{{core_url}}/api/v1/audit/entries?subject_id={{s15_rec1}}&limit=10'),
      method: 'GET',
      headers: { Authorization: 'Bearer ' + bru.getVar('auditor_token') },
    });
    const e = ((r.data && r.data.items) || []).find(x => x.action === 'create');
    if ((e && e.seq) || Date.now() - t0 > 330 * 1000) break;
    await bru.sleep(1000);
  }
  bru.setVar('s15_polled_s_rec1', String(Math.round((Date.now() - t0) / 1000)));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const items = N.json().items;
  const e = items.find(x => x.action === 'create');
  test("the incident's create entry is on the auditor's timeline", () => expect(e).to.be.an('object'));
  test('sealed: a seq of 1 or more, and a sealed_at', () => {
    expect(e.seq).to.be.a('number').and.at.least(1);
    expect(e.sealed_at).to.be.a('string');
  });
  const lat = (Date.parse(e.sealed_at) - Date.parse(e.occurred_at)) / 1000;
  test('sealed 300 s or less after it was written (sealed_at - occurred_at, database clock)', () => expect(lat).to.be.at.least(0).and.at.most(300));
  bru.setVar('s15_seq_rec1', String(e.seq));
  console.log('S15.7:', JSON.stringify({ seq: e.seq, occurred_at: e.occurred_at, sealed_at: e.sealed_at, latency_s: lat, polled_s: Number(bru.getVar('s15_polled_s_rec1')) }));
}

docs {
  The auditor reads the entry of S15.6 until it has a `seq`. Tenant A may have been idle, so the bound here is AC3's 300 s; S15.9 shows the active case.
}
