meta {
  name: S15.6 AC1: Alice creates a first incident: 201
  type: http
  seq: 6
}

post {
  url: {{core_url}}/api/v1/records/incident
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: tick443-s15-{{s15_run}}-rec1
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "S15 {{s15_run}} rec1",
      "priority": 2
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  const b = N.json();
  test('version 1', () => expect(b.version).to.eql(1));
  bru.setVar('s15_rec1', b.id);
}

docs {
  The first write after the stack has been quiet, so tenant A's sealer may have backed off (up to 300 s, R16). S15.7 waits for it; the run that seals it resets the interval to 10 s.
}
