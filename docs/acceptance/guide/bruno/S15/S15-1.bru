meta {
  name: S15.1 Sign in as the operator
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: nava-operator-cli
  scope: openid
  username: {{operator_username}}
  password: {{operator_password}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200 from Keycloak', () => expect(res.getStatus()).to.eql(200));
  const tok = N.json();
  test('access token issued', () => expect(tok.access_token).to.be.a('string'));
  bru.setVar('operator_token', tok.access_token);
}

docs {
  Signs in as `{{operator_username}}` through Keycloak (client `nava-operator-cli`, password grant) and keeps the access token in the runtime variable `operator_token`.
}
