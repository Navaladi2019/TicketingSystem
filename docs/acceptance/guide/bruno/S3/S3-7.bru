meta {
  name: S3.7 Negative: tampered token (payload changed)
  type: http
  seq: 7
}

get {
  url: {{core_url}}/api/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tampered_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  bru.setVar('tampered_token', N.rewrite(bru.getVar('alice_token'), c => { c.organization = { 'tenant-b': { id: '00000000-0000-4000-8000-0000000000b1' } }; }));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_token', 401);
  N.noLeak('00000000-0000-4000-8000-0000000000b1');
}

docs {
  Alice's token with the organization in its payload rewritten to tenant B. The signature no longer matches.
}
