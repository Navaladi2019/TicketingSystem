meta {
  name: S3.18 Setup: add Carol to tenant A's organization
  type: http
  seq: 18
}

post {
  url: {{keycloak_url}}/admin/realms/{{realm}}/organizations/00000000-0000-4000-8000-0000000000a1/members
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{kc_admin_token}}
  Content-Type: application/json
}

body:json {
  "{{carol_id}}"
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  await N.kcAdmin();
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('member (201) or already (409)', () => expect(res.getStatus()).to.be.oneOf([201, 409]));
}

docs {
  201, or 409 when she is already a member.
}
