meta {
  name: S3.16 Setup: create Carol
  type: http
  seq: 16
}

post {
  url: {{keycloak_url}}/admin/realms/{{realm}}/users
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{kc_admin_token}}
  Content-Type: application/json
}

body:json {
  {
    "username": "{{carol_username}}",
    "email": "{{carol_username}}",
    "enabled": true,
    "emailVerified": true,
    "firstName": "Carol",
    "lastName": "TwoOrgs",
    "credentials": [
      {
        "type": "password",
        "value": "{{carol_password}}",
        "temporary": false
      }
    ]
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  await N.kcAdmin();
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('created (201) or already there (409)', () => expect(res.getStatus()).to.be.oneOf([201, 409]));
}

docs {
  201, or 409 on a re-run.
}
