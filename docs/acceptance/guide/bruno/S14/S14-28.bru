meta {
  name: S14.28 AC4: a publish with a secret value in the content: 422 config_secret_in_content
  type: http
  seq: 28
}

post {
  url: {{core_url}}/api/v1/entity-types/incident/versions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick437-s14-{{s14_run}}-secret
  Content-Type: application/json
}

body:json {
  {
    "definition": "set by the pre-request script (built from the current incident version)"
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const cur = JSON.parse(bru.getVar('s14_cur_schema'));
  const run = bru.getVar('s14_run');
  const body = (schema) => JSON.stringify({ definition: { schema, fixed_columns: JSON.parse(bru.getVar('s14_fixed')), states: JSON.parse(bru.getVar('s14_states')) } });
  const next = JSON.parse(JSON.stringify(cur));
  next.properties['api_token_s14_' + run] = { type: 'string', title: 'API token', 'x-nava-secret': true, default: 's14-not-a-real-secret-' + run };
  req.setBody(body(next));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('config_secret_in_content', 422);
  N.fieldError('/definition/schema/properties/api_token_s14_' + bru.getVar('s14_run') + '/default');
  N.noLeak('s14-not-a-real-secret-' + bru.getVar('s14_run'));
}

docs {
  The current schema plus a property marked `x-nava-secret` with a `default` value. Refused: `errors[].pointer` names the path; the value appears nowhere in the response.
}
