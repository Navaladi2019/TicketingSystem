meta {
  name: S14.4 listAuditEntries 200: the next page does not overlap
  type: http
  seq: 4
}

get {
  url: {{core_url}}/api/v1/audit/entries?limit=2&page_token={{s14_token}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

script:pre-request {
  if (!bru.getVar('s14_token')) { bru.runner.skipRequest(); }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('no entry of the first page', () => {
    const first = JSON.parse(bru.getVar('s14_first_ids'));
    N.json().items.forEach(e => expect(first).to.not.include(e.id));
  });
}

docs {
  Skipped when the tenant has two entries or fewer. The second page shares no entry with the first.
}
