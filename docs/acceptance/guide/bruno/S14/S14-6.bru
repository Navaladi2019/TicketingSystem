meta {
  name: S14.6 listAuditEntries 200: a subject nobody wrote is an empty page
  type: http
  seq: 6
}

get {
  url: {{core_url}}/api/v1/audit/entries?subject_id=00000000-0000-4000-8000-00000000dead
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('no items, no next page', () => { expect(N.json().items).to.eql([]); expect(N.json().next_page_token || '').to.eql(''); });
}

docs {
  An empty result is an empty page, not an error.
}
