meta {
  name: S14.5 listAuditEntries 200: the domain filter
  type: http
  seq: 5
}

get {
  url: {{core_url}}/api/v1/audit/entries?domain=config&limit=50
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('every entry is config', () => N.json().items.forEach(e => expect(e.domain).to.eql('config')));
}

docs {
  Only `config` entries (entity types).
}
