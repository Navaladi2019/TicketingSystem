meta {
  name: X2.18 onboardTenant 422: an IdP URL on loopback
  type: http
  seq: 18
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{x2_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{x2_domain}}",
    "email_domains": [
      "{{x2_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://127.0.0.1/auth",
        "tokenUrl": "https://127.0.0.1/token",
        "jwksUrl": "https://127.0.0.1/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_idp_config', 422);
  N.noLeak('127.0.0.1');
}

docs {
  IdP URLs must resolve to public hosts.
}
