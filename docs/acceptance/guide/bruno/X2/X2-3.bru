meta {
  name: X2.3 onboardTenant 401: no token
  type: http
  seq: 3
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{x2_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{x2_domain}}",
    "email_domains": [
      "{{x2_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

script:pre-request {
  // One run id per pass, so the folder can run again on the same stack.
  const run = Math.random().toString(16).slice(2, 10);
  bru.setVar('run_id', run);
  bru.setVar('x2_domain', `x2-${run}.test`);
  bru.setVar('x2_domain2', `x22-${run}.test`);
  bru.setVar('x2_domain3', `x23-${run}.test`);
  bru.setVar('x2_key', `tick331-x2-${run}-1`);
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_token', 401);
  test('WWW-Authenticate: Bearer', () => expect(N.header('WWW-Authenticate')).to.match(/^Bearer/));
}

docs {
  Missing token.
}
