meta {
  name: X2.5 onboardTenant 401: a master-realm token (wrong issuer)
  type: http
  seq: 5
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{foreign_token}}
  Idempotency-Key: {{x2_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{x2_domain}}",
    "email_domains": [
      "{{x2_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const r = await N.token(N.v('kc_admin_user'), N.v('kc_admin_password'), { client: 'admin-cli', realm: 'master' });
  bru.setVar('foreign_token', r.data.access_token);
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_token', 401);
}

docs {
  Neither an operator nor a tenant token: 401, not 403.
}
