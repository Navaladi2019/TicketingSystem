meta {
  name: X2.21 onboardTenant 201: the minimal body
  type: http
  seq: 21
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{x2_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{x2_domain}}",
    "email_domains": [
      "{{x2_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  const b = N.json();
  test('Content-Type application/json', () => expect(N.header('Content-Type')).to.include('application/json'));
  test('OnboardedTenant: tenant_id uuid, state active, nothing else', () => {
    expect(b.tenant_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);
    expect(b.state).to.eql('active');
    expect(Object.keys(b).sort()).to.eql(['state', 'tenant_id']);
  });
  bru.setVar('x2_tenant_id', b.tenant_id);
}

docs {
  Only the required fields (no `display_name`). Nothing in X2.3–X2.19 created anything, so the key is still fresh.
}
