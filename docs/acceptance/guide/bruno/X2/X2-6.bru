meta {
  name: X2.6 onboardTenant 403: a tenant B user's token (wrong tenant)
  type: http
  seq: 6
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bob_token}}
  Idempotency-Key: {{x2_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{x2_domain}}",
    "email_domains": [
      "{{x2_domain}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('forbidden', 403);
  N.noLeak('00000000-0000-4000-8000-0000000000b1');
}

docs {
  A valid tenant token is never an operator token.
}
