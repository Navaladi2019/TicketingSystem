meta {
  name: X2.2 Sign in as Bob (a tenant B user)
  type: http
  seq: 2
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: nava-web
  scope: openid
  username: {{bob_username}}
  password: {{bob_password}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200 from Keycloak', () => expect(res.getStatus()).to.eql(200));
  const tok = N.json();
  test('access token issued', () => expect(tok.access_token).to.be.a('string'));
  bru.setVar('bob_token', tok.access_token);
  if (tok.id_token) bru.setVar('bob_token_id', tok.id_token);
  const c = N.jwt(tok.access_token);
  bru.setVar('bob_token_exp', String(c.exp));
  test('issuer is the pinned realm URL', () => expect(c.iss).to.eql(N.url('{{keycloak_issuer_url}}/realms/{{realm}}')));
}

docs {
  Signs in as `{{bob_username}}` through Keycloak (client `nava-web`, password grant) and keeps the access token in the runtime variable `bob_token`.
}
