meta {
  name: X2.15 onboardTenant 400: a public email-provider domain
  type: http
  seq: 15
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{operator_token}}
  Idempotency-Key: {{x2_key}}
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "someone@gmail.com",
    "email_domains": [
      "gmail.com"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('validation_failed', 400);
  N.fieldError('/email_domains');
  N.noLeak('gmail.com');
}

docs {
  Public email-provider domains are refused.
}
