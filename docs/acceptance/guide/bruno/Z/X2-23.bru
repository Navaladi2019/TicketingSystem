meta {
  name: X2.23 onboardTenant 401: an expired operator token
  type: http
  seq: 2
}

post {
  url: {{onboard_url}}/api/v1/operator/tenants
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{expiring_operator_token}}
  Idempotency-Key: tick331-expired
  Content-Type: application/json
}

body:json {
  {
    "admin_email": "admin@{{seed_domain_a}}",
    "email_domains": [
      "{{seed_domain_a}}"
    ],
    "identity_provider": {
      "provider_id": "oidc",
      "display_name": "Acceptance IdP",
      "config": {
        "clientId": "acceptance-client",
        "clientSecret": "dev-only-not-a-secret",
        "authorizationUrl": "https://93.184.216.34/auth",
        "tokenUrl": "https://93.184.216.34/token",
        "jwksUrl": "https://93.184.216.34/jwks",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      }
    }
  }
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const exp = Number(bru.getVar('expiring_operator_token_exp') || 0);
  if (!exp) {
    // Run on its own: sign in now and wait the full lifespan.
    const r = await N.token(N.v('operator_username'), N.v('operator_password'), { client: 'nava-operator-cli' });
    bru.setVar('expiring_operator_token', r.data.access_token);
    bru.setVar('expiring_operator_token_exp', String(N.jwt(r.data.access_token).exp));
  }
  // nava-core and nava-onboard allow 30 s of clock skew on exp (internal/identity/keycloak), so wait past that.
  const wait = Math.max(0, Number(bru.getVar('expiring_operator_token_exp')) * 1000 + 40000 - Date.now());
  if (wait > 0) { console.log(`waiting ${Math.round(wait / 1000)} s for the token to expire`); await bru.sleep(wait); }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('invalid_token', 401);
  test('the token is past exp plus the 30 s skew', () => expect(Date.now() / 1000).to.be.above(Number(bru.getVar('expiring_operator_token_exp')) + 30));
}

docs {
  The operator token from S4.1, now expired.
}
