meta {
  name: S14.20 AC1: Alice updates it with its ETag: 200
  type: http
  seq: 10
}

patch {
  url: {{core_url}}/api/v1/records/incident/{{s14_rec}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: tick437-s14-{{s14_run}}-update
  Content-Type: application/merge-patch+json
  If-Match: W/"1"
}

body:json {
  {
    "data": {
      "priority": 1
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('version 2, priority 1', () => { expect(N.json().version).to.eql(2); expect(N.json().data.priority).to.eql(1); });
}

docs {
  Priority 2 to 1, based on version 1.
}
