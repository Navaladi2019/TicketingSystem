meta {
  name: S16.8 exportAuditEntries 200: filtered by domain
  type: http
  seq: 8
}

get {
  url: {{core_url}}/api/v1/audit/entries:export?domain=config
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{auditor_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  await require('./lib/s15')(N, bru).fresh();
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  const ls = N.text().split('\n').filter(l => l.length).map(l => JSON.parse(l));
  N.status(200);
  test('full lines are config; the rest are stubs', () => {
    ls.filter(l => l.kind === 'entry' && l.sealed).forEach(l => expect(l.envelope.domain).to.eql('config'));
    ls.filter(l => l.kind === 'stub').forEach(l => expect(Object.keys(l).sort()).to.eql(['entry_hash', 'envelope_sha256', 'kind', 'prev_hash', 'seq']));
  });
}

docs {
  Entries of the config domain are in full; every other seq of the range is a hash-only stub. The file still verifies.
}
