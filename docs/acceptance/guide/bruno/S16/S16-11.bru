meta {
  name: S16.11 AC4: reseedAuditChain 409 chain_alive while sealing runs
  type: http
  seq: 11
}

post {
  url: {{core_url}}/api/v1/audit/chain:reseed
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{auditor_token}}
  Idempotency-Key: {{$guid}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  await require('./lib/s15')(N, bru).fresh();
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('chain_alive', 409);
}

docs {
  The seal lineage of a running stack is alive (R17), so the reseed is refused and writes nothing. A dead lineage is reseeded in the integration tests (P5-35).
}
