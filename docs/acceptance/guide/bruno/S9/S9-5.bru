meta {
  name: S9.5 AC1: the same Idempotency-Key again: the same record
  type: http
  seq: 5
}

post {
  url: {{core_url}}/api/v1/records/incident
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: tick359-s9-{{s9_run}}-create
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "S9 {{s9_run}} printer on fire",
      "priority": 2
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  const b = N.json();
  test('the same id and number as S9.4', () => {
    expect(b.id).to.eql(bru.getVar('s9_id'));
    expect(b.number).to.eql(bru.getVar('s9_number'));
  });
  test('the same ETag', () => expect(N.header('ETag')).to.eql('W/"1"'));
}

docs {
  The retry returns the stored response: the same id, number and `ETag`. S9.8 shows no number was used up, and the stack case counts exactly one record.
}
