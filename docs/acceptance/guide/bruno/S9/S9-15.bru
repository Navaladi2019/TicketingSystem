meta {
  name: S9.15 AC5: agent@tenant-b reads an id that does not exist: 404
  type: http
  seq: 19
}

get {
  url: {{core_url}}/api/v1/records/incident/00000000-0000-4000-8000-00000000dead
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{bob_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json, code not_found, no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  N.status(404);
  bru.setVar('s9_ref404', N.text());
}

docs {
  The reference 404 for S9.16 to S9.18.
}
