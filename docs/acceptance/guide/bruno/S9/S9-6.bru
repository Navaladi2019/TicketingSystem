}

body:json {
  {
    "data": {
      "description": "S9 {{s9_run}} invalid",
      "priority": 9
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('record_invalid', 422);
  N.fieldError('/data/short_description');
  N.fieldError('/data/priority');
}

docs {
  No `short_description` (required) and a `priority` outside 1-4: 422 `record_invalid` with an error per field. S9.8 and the stack case show it created no record and no history.
}
