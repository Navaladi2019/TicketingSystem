meta {
  name: S9.17 AC5: agent@tenant-b updates tenant A's incident: the same 404
  type: http
  seq: 17
}

patch {
  url: {{core_url}}/api/v1/records/incident/{{s9_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bob_token}}
  Idempotency-Key: tick359-s9-{{s9_run}}-bob-patch
  Content-Type: application/merge-patch+json
  If-Match: W/"2"
}

body:json {
  {
    "data": {
      "priority": 4
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json, code not_found, no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  N.status(404);
  test("body byte-identical to S9.15's 404", () => expect(N.text()).to.eql(bru.getVar('s9_ref404')));
  N.noLeak(bru.getVar('s9_id'), bru.getVar('s9_number'), 'S9 ' + bru.getVar('s9_run'));
}

docs {
  Tenant B writing tenant A's data, with A's current `ETag`: the same 404, never 412 or 428. S9.19 shows nothing changed.
}
