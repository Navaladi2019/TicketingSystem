meta {
  name: S9.14 AC3: the second incident's history is its create
  type: http
  seq: 14
}

get {
  url: {{core_url}}/api/v1/records/incident/{{s9_id2}}/history
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

script:pre-request {
  // D-5-14 (TICK-452): since P5-13b the pipeline writes audit_log, and the
  // history endpoint reads audit_log_v0 until P5-17 rebuilds it. P5-17
  // (TICK-435) removes this gate and turns the request back on.
  console.log("SKIPPED S9.14: gated on TICK-435 (P5-17), the history endpoint on the new audit log (D-5-14)");
  bru.runner.skipRequest();
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const items = N.json().items;
  test('one create row by Alice, source user', () => {
    expect(items).to.have.length(1);
    expect(items[0].action).to.eql('create');
    expect(items[0].actor_id).to.eql(bru.getVar('s9_alice'));
    expect(items[0].source).to.eql('user');
  });
}

docs {
  One row: the create of S9.8, by Alice, `source: user`.
}
