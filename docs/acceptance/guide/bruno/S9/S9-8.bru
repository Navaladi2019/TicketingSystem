meta {
  name: S9.8 AC1, AC4: the next incident gets the next number, no gap
  type: http
  seq: 10
}

post {
  url: {{core_url}}/api/v1/records/incident
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: tick359-s9-{{s9_run}}-second
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "S9 {{s9_run}} second"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
  const b = N.json();
  const n = Number(bru.getVar('s9_number').slice(3)) + 1;
  const want = 'INC' + String(n).padStart(7, '0');
  test(`number ${want}: no gap after S9.4`, () => expect(b.number).to.eql(want));
  bru.setVar('s9_id2', b.id);
}

docs {
  The number after S9.4's. Neither the retry (S9.5) nor the refused create (S9.6) used a number up: "creates nothing" is checked as no gap.
}
