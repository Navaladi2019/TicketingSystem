meta {
  name: X5.21 patchRecord 404: an unknown entity type, no If-Match
  type: http
  seq: 21
}

patch {
  url: {{core_url}}/api/v1/records/no_such_type_x5/{{x5_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: {{x5_key5}}
  Content-Type: application/merge-patch+json
}

body:json {
  {
    "data": {
      "short_description": "Printer fixed"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json with code not_found and no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    const b = N.json();
    expect(b.code).to.eql('not_found');
    expect(b).to.not.have.property('instance');
  });
  N.status(404);
}

docs {
  404 `not_found` with no `instance`. A missing record or type never answers 428.
}
