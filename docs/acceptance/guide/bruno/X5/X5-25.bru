meta {
  name: X5.25 patchRecord 412: the old ETag
  type: http
  seq: 25
}

patch {
  url: {{core_url}}/api/v1/records/{{x5_type}}/{{x5_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: {{x5_key9}}
  Content-Type: application/merge-patch+json
  If-Match: W/"1"
}

body:json {
  {
    "data": {
      "short_description": "Printer fixed"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('version_conflict', 412);
  test('current ETag in the header and the detail, no data', () => {
    expect(N.header('ETag')).to.eql('W/"2"');
    expect(N.json().detail).to.include('W/"2"');
    expect(N.text()).to.not.include('Printer');
  });
}

docs {
  Stale: 412 `version_conflict`, the current `ETag` in the header and in `detail`, no record data.
}
