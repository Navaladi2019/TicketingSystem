meta {
  name: X5.7 createRecord 404: an unknown entity type
  type: http
  seq: 7
}

post {
  url: {{core_url}}/api/v1/records/no_such_type_x5
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
  Idempotency-Key: {{x5_key1}}
  Content-Type: application/json
}

body:json {
  {
    "data": {
      "short_description": "Printer on fire"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json with code not_found and no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    const b = N.json();
    expect(b.code).to.eql('not_found');
    expect(b).to.not.have.property('instance');
  });
  N.status(404);
}

docs {
  404 `not_found` with no `instance`, before the body is read.
}
