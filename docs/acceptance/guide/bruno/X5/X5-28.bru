meta {
  name: X5.28 getRecordHistory 200: newest first
  type: http
  seq: 28
}

get {
  url: {{core_url}}/api/v1/records/{{x5_type}}/{{x5_id}}/history
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  test('update then create', () => {
    const b = N.json();
    expect(b.items.map(i => i.action)).to.eql(['update', 'create']);
    expect(b.items[0].changed).to.eql(['/data/short_description']);
    expect(b.items[0].before.short_description).to.eql('Printer on fire');
    expect(b.items[0].after.short_description).to.eql('Printer fixed');
    expect(b.items[1]).to.not.have.property('before');
  });
}

docs {
  Two changes: the update, then the create. `changed` names the JSON pointers under `/data`.
}
