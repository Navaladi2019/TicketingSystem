meta {
  name: S28.5 Stand-in: add the user to the tenant's organization: 201
  type: http
  seq: 5
}

post {
  url: {{keycloak_url}}/admin/realms/{{realm}}/organizations/{{s28_org}}/members
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{kc_admin_token}}
  Content-Type: application/json
}

body:json {
  "{{s28_user}}"
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  await N.kcAdmin();

  const o = await N.send({ url: N.url('{{keycloak_url}}/admin/realms/{{realm}}/organizations?search=t-{{s28_tenant}}&exact=true'),
    method: 'GET', headers: { Authorization: 'Bearer ' + bru.getVar('kc_admin_token') } });
  const org = (o.data || []).find(x => x.alias === 't-' + bru.getVar('s28_tenant'));
  if (!org) throw new Error('S28.5: no organization t-' + bru.getVar('s28_tenant') + ' (HTTP ' + o.status + ')');
  bru.setVar('s28_org', org.id);
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(201);
}

docs {
  Local stack only, platform staff (F1). The first-login flow adds the new user to the tenant's organization (`t-<tenant_id>`), which puts the `organization` claim in their token.
}
