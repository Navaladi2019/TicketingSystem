meta {
  name: S28.6 The new admin signs in
  type: http
  seq: 6
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: nava-web
  scope: openid
  username: {{s28_admin_email}}
  password: {{s28_admin_password}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200 from Keycloak', () => expect(res.getStatus()).to.eql(200));
  const tok = N.json();
  test('access token issued', () => expect(tok.access_token).to.be.a('string'));
  bru.setVar('s28_admin_token', tok.access_token);
  if (tok.id_token) bru.setVar('s28_admin_token_id', tok.id_token);
  const c = N.jwt(tok.access_token);
  bru.setVar('s28_admin_token_exp', String(c.exp));
  test('issuer is the pinned realm URL', () => expect(c.iss).to.eql(N.url('{{keycloak_issuer_url}}/realms/{{realm}}')));
  test('the token names exactly the organization of the new tenant', () => {
    const orgs = c.organization || {};
    expect(Object.keys(orgs)).to.eql(['t-' + bru.getVar('s28_tenant')]);
    expect(orgs['t-' + bru.getVar('s28_tenant')].id).to.eql(bru.getVar('s28_org'));
  });
}

docs {
  Signs in as `{{s28_admin_email}}` through Keycloak (client `nava-web`, password grant) and keeps the access token in the runtime variable `s28_admin_token`.
}
