meta {
  name: S21.14 AC1: filter[priority]=1 as Alice gives exactly the JSON scan's rows she may read
  type: http
  seq: 14
}

get {
  url: {{core_url}}/api/v1/records/incident?filter[priority]=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/s21')(N, bru);
  const all = await T.all('alice_token', 'filter[priority]=1');
  bru.setVar('s21_all_p1_agent', JSON.stringify({ ids: all.ids, pages: all.pages, items: all.items.map(i => ({ priority: i.data.priority, due_at: i.data.due_at })) }));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const all = JSON.parse(bru.getVar('s21_all_p1_agent'));
  const want = Number(N.v('s21_p1_agent_n'));
  test(`Alice: ${all.ids.length} records over ${all.pages} pages; the JSON scan has ${want}`, () => expect(all.ids.length).to.eql(want));
  test('the same records as the JSON scan (md5 of the sorted ids)', () => expect(require('crypto').createHash('md5').update([...all.ids].sort().join(',')).digest('hex')).to.eql(N.v('s21_p1_agent_md5')));
  test('no record listed twice', () => expect(new Set(all.ids).size).to.eql(all.ids.length));
  test('total: exact up to 1,000, then 1,000 and total_capped', () => {
    expect(N.json().total).to.eql(Math.min(want, 1000));
    expect(N.json().total_capped === true).to.eql(want > 1000);
  });
  test('every listed record matches the filter', () => expect(all.items.filter(d => !(d.priority === 1)).length).to.eql(0));
  bru.setVar('s21_ids_p1_agent', JSON.stringify(all.ids));
}

docs {
  The same filter as Alice, against the JSON scan restricted to what the default incident ACL lets her read (assigned to service-desk, or raised by her).
}
