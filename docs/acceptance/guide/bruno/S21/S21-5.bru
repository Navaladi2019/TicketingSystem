meta {
  name: S21.5 AC3: Alice filters on the masked field description: 400 masked_field
  type: http
  seq: 5
}

get {
  url: {{core_url}}/api/v1/records/incident?filter[description]=S21%20internal%20note%201
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alice_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('masked_field', 400);
  test('no items and no total', () => { expect(N.json()).to.not.have.property('items'); expect(N.json()).to.not.have.property('total'); });
}

docs {
  `description` is masked to tenant A's admins group (tools/kit.mjs setup). Alice is not in it: 400 `masked_field`, before anything is read, and no `total`.
}
