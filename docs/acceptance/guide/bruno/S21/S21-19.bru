meta {
  name: S21.19 AC2: list p95 within ADR-006 D13 (as amended by ADR-006-A1)
  type: http
  seq: 19
}

get {
  url: {{core_url}}/api/v1/records/incident?limit=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/s21')(N, bru);
  const secs = Number(N.v('s21_p95_seconds') || 15);
  const a = Number(N.v('s21_a_n'));
  const share = (n) => Math.round((Number(N.v(n)) / a) * 10000) / 100 + '%';
  const cells = [
    ['admin', 'admin_a_token', 'filter[priority]=1', share('s21_p1_admin_n') + ' of the type, 0.5-2% band, no narrowing ACL', 350],
    ['admin', 'admin_a_token', 'filter[priority]=3', share('s21_p3_admin_n') + ' of the type, >= 40% band, no narrowing ACL', 150],
    ['admin', 'admin_a_token', 'filter[priority][gte]=2&filter[due_at][lt]=2026-01-01T12:00:00Z', share('s21_ac2_admin_n') + ' of the type, below 0.5%, no narrowing ACL', 150],
    ['Alice', 'alice_token', 'filter[priority]=1', share('s21_p1_admin_n') + ' of the type, 0.5-2% band, narrowing ACL', 350],
    ['Alice', 'alice_token', 'filter[priority]=3', share('s21_p3_admin_n') + ' of the type, >= 40% band, narrowing ACL', 350],
    ['Alice', 'alice_token', 'filter[priority][gte]=2&filter[due_at][lt]=2026-01-01T12:00:00Z', share('s21_ac2_admin_n') + ' of the type, below 0.5%, narrowing ACL', 150],
    ['admin', 'admin_a_token', '', 'no filter (control, reported only)', null],
    ['Alice', 'alice_token', '', 'no filter (control, reported only)', null],
  ];
  const out = [];
  for (const [who, v, q, band, limit] of cells) {
    const r = await T.cell(v, q, secs);
    out.push({ who, filter: q || '(none)', band, limit_ms: limit, ...r });
    console.log(`S21.19 ${who} ${q || '(none)'}: p50 ${r.p50} p95 ${r.p95} max ${r.max} ms, ${r.n} requests (${r.rps}/s), ${JSON.stringify(r.statuses)}`);
  }
  bru.setVar('s21_p95', JSON.stringify(out));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const cells = JSON.parse(bru.getVar('s21_p95'));
  cells.forEach(c => {
    test(`${c.who} ${c.filter} (${c.band}): only 200s, ${c.n} requests`, () => { expect(Object.keys(c.statuses)).to.eql(['200']); expect(c.n).to.be.above(0); });
    if (c.limit_ms !== null) test(`${c.who} ${c.filter}: p95 ${c.p95} ms <= ${c.limit_ms} ms (p50 ${c.p50}, max ${c.max})`, () => expect(c.p95).to.be.at.most(c.limit_ms));
  });
}

docs {
  Each cell: 8 clients list with the kit's filter for `s21_p95_seconds` (default 15 s) after 2 s of warm-up, paced to 40 requests a second together so the tenant stays under its 50/s rate limit (a 429 fails the cell). Latency is the client's, through nava-core and PgBouncer, default page (50). Limits (ADR-006 D13 as amended by ADR-006-A1, `docs/budgets.md`): 350 ms for the 0.5-2% band with or without a narrowing ACL and for the >= 40% band with one (Alice); 150 ms for every other filter. No 2-40% filter is asserted (unmeasured until TICK-1009). The no-filter control is reported, not scored.
}
