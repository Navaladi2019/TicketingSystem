meta {
  name: S21.13 AC1: filter[priority]=1 as the admin gives exactly the JSON scan's rows
  type: http
  seq: 13
}

get {
  url: {{core_url}}/api/v1/records/incident?filter[priority]=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/s21')(N, bru);
  const all = await T.all('admin_a_token', 'filter[priority]=1');
  bru.setVar('s21_all_p1_admin', JSON.stringify({ ids: all.ids, pages: all.pages, states: all.states, broken: all.broken, items: all.items.map(i => ({ priority: i.data.priority, due_at: i.data.due_at })) }));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const T = require('./lib/s21')(N, bru);
  const all = JSON.parse(bru.getVar('s21_all_p1_admin'));
  const want = Number(N.v('s21_p1_admin_n'));
  test(`admin: ${all.ids.length} records over ${all.pages} pages; the JSON scan has ${want}`, () => expect(all.ids.length).to.eql(want));
  test('the same records as the JSON scan (md5 of the sorted ids)', () => expect(require('crypto').createHash('md5').update([...all.ids].sort().join(',')).digest('hex')).to.eql(N.v('s21_p1_admin_md5')));
  test('no record listed twice', () => expect(new Set(all.ids).size).to.eql(all.ids.length));
  const first = N.json();
  test(`every page meets the total contract (A2-1): this page ${first.total_state}, the limit-200 pages ${JSON.stringify(all.states)}`, () => {
    expect(T.contract(first)).to.eql(null);
    expect(all.broken).to.eql([]);
  });
  test('total: exact up to 1,000, capped at 1,000 past it, or null when unknown', () => {
    if (first.total_state === 'unknown') expect(first.total).to.eql(null);
    else { expect(first.total).to.eql(Math.min(want, 1000)); expect(first.total_state).to.eql(want > 1000 ? 'capped' : 'exact'); }
  });
  if (want < 50) test(`a short result (${want} < 50 matches): exact on the first page (A2-4)`, () => {
    expect(first.total_state).to.eql('exact');
    expect(first.total).to.eql(want);
  });
  test('every listed record matches the filter', () => expect(all.items.filter(d => !(d.priority === 1)).length).to.eql(0));
  bru.setVar('s21_ids_p1_admin', JSON.stringify(all.ids));
}

docs {
  Every page of `filter[priority]=1` (limit 200) as the admin, against `tools/expect.sql`'s JSON scan of tenant A (`data->>'priority' = '1'`, 1% of 400k): the same count and the same ids. Every page meets the total contract (ADR-006-A2 A2-1): `total_state` exact, capped or unknown; `total` exact up to 1,000, 1,000 when capped, null when unknown. A result shorter than the page answers exact (A2-4).
}
