meta {
  name: S21.13 AC1: filter[priority]=1 as the admin gives exactly the JSON scan's rows
  type: http
  seq: 13
}

get {
  url: {{core_url}}/api/v1/records/incident?filter[priority]=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/s21')(N, bru);
  const all = await T.all('admin_a_token', 'filter[priority]=1');
  bru.setVar('s21_all_p1_admin', JSON.stringify({ ids: all.ids, pages: all.pages, items: all.items.map(i => ({ priority: i.data.priority, due_at: i.data.due_at })) }));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const all = JSON.parse(bru.getVar('s21_all_p1_admin'));
  const want = Number(N.v('s21_p1_admin_n'));
  test(`admin: ${all.ids.length} records over ${all.pages} pages; the JSON scan has ${want}`, () => expect(all.ids.length).to.eql(want));
  test('the same records as the JSON scan (md5 of the sorted ids)', () => expect(require('crypto').createHash('md5').update([...all.ids].sort().join(',')).digest('hex')).to.eql(N.v('s21_p1_admin_md5')));
  test('no record listed twice', () => expect(new Set(all.ids).size).to.eql(all.ids.length));
  test('total: exact up to 1,000, then 1,000 and total_capped', () => {
    expect(N.json().total).to.eql(Math.min(want, 1000));
    expect(N.json().total_capped === true).to.eql(want > 1000);
  });
  test('every listed record matches the filter', () => expect(all.items.filter(d => !(d.priority === 1)).length).to.eql(0));
  bru.setVar('s21_ids_p1_admin', JSON.stringify(all.ids));
}

docs {
  Every page of `filter[priority]=1` (limit 200) as the admin, against `tools/expect.sql`'s JSON scan of tenant A (`data->>'priority' = '1'`, 1% of 400k): the same count and the same ids. `total` is exact up to 1,000.
}
