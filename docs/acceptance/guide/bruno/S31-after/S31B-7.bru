meta {
  name: S31B.7 The admin finds the Germany requester's tickets
  type: http
  seq: 7
}

get {
  url: {{core_url}}/api/v1/records/incident?limit=200&filter[requester]={{s31_req_de}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const items = N.json().items;
  test('at least one ticket', () => expect(items.length).to.be.above(0));
  bru.setVar('s31_de_ids', JSON.stringify(items.map(i => i.id)));
}

docs {
  The admin reads every incident (`admins`), so this is every ticket part one raised for them.
}
