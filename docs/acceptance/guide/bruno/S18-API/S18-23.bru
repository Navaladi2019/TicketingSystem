  If-Match: W/"2"
  Content-Type: application/json
}

body:json {
  {
    "document": {
      "template": "{prefix}-{yyyy}{MM}-{seq:4}",
      "overflow": "grow"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('forbidden', 403);
}

docs {
