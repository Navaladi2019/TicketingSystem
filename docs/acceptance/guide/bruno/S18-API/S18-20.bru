  If-Match: W/"1"
  Content-Type: application/json
}

body:json {
  {
    "document": {
      "template": "{prefix}",
      "overflow": "grow"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('number_format_invalid', 422);
}

docs {
  A template with no `{seq:N}`.
}
