meta {
  name: S18.20 Publish an invalid document: 422
  type: http
  seq: 20
}

put {
  url: {{core_url}}/api/v1/number-formats/{{s18_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
