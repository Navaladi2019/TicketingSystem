meta {
  name: S18.19 Publish on a stale If-Match: 412
  type: http
  seq: 19
}

put {
  url: {{core_url}}/api/v1/number-formats/{{s18_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick672-{{s18_run}}-p412
  If-Match: W/"9"
  Content-Type: application/json
}

body:json {
  {
    "document": {
      "template": "{prefix}-{yyyy}{MM}-{seq:4}",
      "overflow": "grow"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('version_conflict', 412);
}

docs {
  The current `ETag` is in the response header.
}
