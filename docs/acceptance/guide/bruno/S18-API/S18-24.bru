meta {
  name: S18.24 Publish an unknown id: 404
  type: http
  seq: 24
}

put {
  url: {{core_url}}/api/v1/number-formats/00000000-0000-4000-8000-00000000ffff
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Idempotency-Key: tick672-{{s18_run}}-p404
  If-Match: W/"1"
  Content-Type: application/json
}

body:json {
  {
    "document": {
      "template": "{prefix}-{yyyy}{MM}-{seq:4}",
      "overflow": "grow"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json, code not_found, no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  N.status(404);
}
