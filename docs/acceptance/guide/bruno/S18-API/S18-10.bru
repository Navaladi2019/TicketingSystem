meta {
  name: S18.10 Create without an Idempotency-Key: 400
  type: http
  seq: 10
}

post {
  url: {{core_url}}/api/v1/number-formats
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  Content-Type: application/json
}

body:json {
  {
    "key": "{{s18_fmt}}_c",
    "document": {
      "template": "{prefix}-{yyyy}{MM}-{seq:4}",
      "overflow": "grow"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('validation_failed', 400);
}
