meta {
  name: S18.25 Publish without an Idempotency-Key: 400
  type: http
  seq: 25
}

put {
  url: {{core_url}}/api/v1/number-formats/{{s18_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
  If-Match: W/"2"
  Content-Type: application/json
}

body:json {
  {
    "document": {
      "template": "{prefix}-{yyyy}{MM}-{seq:4}",
      "overflow": "grow"
    }
  }
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('validation_failed', 400);
}
