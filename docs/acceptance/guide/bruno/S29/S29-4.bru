meta {
  name: S29.4 The incident type: s29_level has no default, s29_tier is optional, no backfill yet
  type: http
  seq: 4
}

get {
  url: {{core_url}}/api/v1/entity-types/incident
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const b = N.json();
  test('s29_level is flagged with no default; s29_tier is optional with no default', () => {
    expect(b.schema.properties.s29_level['x-nava-filterable']).to.eql(true);
    expect(b.schema.properties.s29_level).to.not.have.property('default');
    expect(b.schema.properties.s29_tier.type).to.eql('string');
    expect(b.schema.properties.s29_tier).to.not.have.property('default');
    expect(b.schema.required || []).to.not.include('s29_tier');
  });
  test('no backfill job before the publish', () => expect(b.backfill == null).to.eql(true));
  bru.setVar('s29_prev', String(b.version));
  bru.setVar('s29_def', JSON.stringify({ schema: b.schema, fixed_columns: b.fixed_columns, states: b.states }));
}

docs {
  kit.mjs setup published a version that adds `s29_level` (integer 1 to 4, flagged `x-nava-filterable`, no default) and an optional `s29_tier` (string), so the seeded records lack both. The incident template already defaults `priority` to 3, and removing a default is breaking (ADR-009 D14), so criterion 1 runs on `s29_level`: the same shape the story describes for `priority`. Kept for the publishes below.
}
