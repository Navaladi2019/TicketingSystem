meta {
  name: S29.8 One real update starts one run of it (the baseline)
  type: http
  seq: 8
}

get {
  url: {{temporal_ui_url}}/api/v1/namespaces/nava/workflows?query=WorkflowType%3D%27nava.interpreter%27%20AND%20WorkflowId%20STARTS_WITH%20%27t%3A00000000-0000-4000-8000-0000000000a1%3A%27
  body: none
  auth: none
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/kit')(N, bru);
  const run = bru.getVar('s29_run');
  // AC4 and AC5 refusals (S29.5, S29.6) stored nothing: the type is still at its version.
  bru.setVar('s29_after_refusals', String((await T.type('admin_a_token', 'incident')).data.version));
  const id = N.v('s29_held_3').split(',')[0];
  const cur = await T.read('admin_a_token', 'incident', id);
  const p = await T.patch('admin_a_token', 'incident', `s29-${run}-baseline-update`, id, cur.data.version, { description: 'S29 baseline update' });
  bru.setVar('s29_baseline', JSON.stringify({ status: p.status, id }));
  // Give the relay a moment to start the run.
  await bru.sleep(10000);
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.status(200);
  const b = JSON.parse(bru.getVar('s29_baseline'));
  test('the baseline update: 200', () => expect(b.status).to.eql(200));
  test('S29.5 and S29.6 stored nothing: the type is still at its version', () => expect(Number(bru.getVar('s29_after_refusals'))).to.eql(Number(bru.getVar('s29_prev'))));
  const ex = N.json().executions || [];
  test('at least one tenant A run (the baseline)', () => expect(ex.length).to.be.above(0));
  bru.setVar('s29_runs_before', String(ex.length));
  console.log('S29.8 tenant A nava.interpreter executions', ex.length);
}

docs {
  Edits one of the 50 API-created incidents (its description) so the test workflow has a waiting run. The listing (Temporal visibility, through `tools/tunnels.sh up`, profile `operator`) is tenant A's `nava.interpreter` workflows; S29.17 lists them again after the job and expects the same count.
}
