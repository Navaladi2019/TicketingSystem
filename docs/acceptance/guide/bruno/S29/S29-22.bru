meta {
  name: S29.22 AC6: tenant B's failures route: 404, the same as a missing type
  type: http
  seq: 22
}

get {
  url: {{core_url}}/api/v1/entity-types/incident/backfill/failures
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_b_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/kit')(N, bru);
  const r = await T.call('admin_b_token', 'GET', '/api/v1/entity-types/s29_no_such_type/backfill/failures');
  bru.setVar('s29_b_missing', JSON.stringify({ status: r.status, code: r.data && r.data.code }));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  N.problem('not_found', 404);
  const m = JSON.parse(bru.getVar('s29_b_missing'));
  test('a missing type answers the same 404', () => { expect(m.status).to.eql(404); expect(m.code).to.eql('not_found'); });
  test("never tenant A's poison id", () => expect(JSON.stringify(N.json())).to.not.include(N.v('s29_poison_id')));
}

docs {
  Tenant B has no job on its incident type, and tenant A's failures are not visible to it. The answer is the 404 a type nobody has gives.
}
