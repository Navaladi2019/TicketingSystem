meta {
  name: S29.22 AC6: tenant B's failures route on its own incident type: none of tenant A's failures
  type: http
  seq: 22
}

get {
  url: {{core_url}}/api/v1/entity-types/incident/backfill/failures
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_b_token}}
}

script:pre-request {
  const N = require('./lib/nava')({ bru });
  const T = require('./lib/kit')(N, bru);
  const r = await T.call('admin_b_token', 'GET', '/api/v1/entity-types/s29_no_such_type/backfill/failures');
  bru.setVar('s29_b_missing', JSON.stringify({ status: r.status, code: r.data && r.data.code }));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('200 with no items (no job on B\'s own type), or 404', () => expect([200, 404]).to.include(res.getStatus()));
  if (res.getStatus() === 200) test('no failure listed', () => expect(N.json().items).to.eql([]));
  const m = JSON.parse(bru.getVar('s29_b_missing'));
  test('a type tenant B does not have: 404 not_found', () => { expect(m.status).to.eql(404); expect(m.code).to.eql('not_found'); });
  test("never tenant A's poison id", () => expect(JSON.stringify(N.json())).to.not.include(N.v('s29_poison_id')));
}

docs {
  Tenant B has its own `incident` type (the same key) and no job on it. Its admin may read that type's failures: PR #960 (TICK-1192) answers a type with no job 200 with empty `items`. It must never show tenant A's failure. A type B does not have answers the 404 a type nobody has gives, as an A-only key would.
}
