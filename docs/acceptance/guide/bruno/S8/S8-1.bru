meta {
  name: S8.1 Sign in as admin@tenant-a (tenant A's admins group)
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: nava-web
  scope: openid
  username: {{admin_a_username}}
  password: {{admin_a_password}}
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 200 from Keycloak', () => expect(res.getStatus()).to.eql(200));
  const tok = N.json();
  test('access token issued', () => expect(tok.access_token).to.be.a('string'));
  bru.setVar('admin_a_token', tok.access_token);
  if (tok.id_token) bru.setVar('admin_a_token_id', tok.id_token);
  const c = N.jwt(tok.access_token);
  bru.setVar('admin_a_token_exp', String(c.exp));
  test('issuer is the pinned realm URL', () => expect(c.iss).to.eql(N.url('{{keycloak_issuer_url}}/realms/{{realm}}')));
  bru.setVar('s8_run', Math.random().toString(16).slice(2, 10));
}

docs {
  Signs in as `{{admin_a_username}}` through Keycloak (client `nava-web`, password grant) and keeps the access token in the runtime variable `admin_a_token`.
}
