meta {
  name: S8.9 AC2: the breaking version was not stored
  type: http
  seq: 9
}

get {
  url: {{core_url}}/api/v1/entity-types/incident/versions/{{s8_next}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_a_token}}
}

script:pre-request {
  bru.setVar('s8_next', String(Number(bru.getVar('s8_prev')) + 1));
}

tests {
  const N = require('./lib/nava')({ test, expect, res, bru });
  test('HTTP 404 problem+json, code not_found, no instance', () => {
    expect(res.getStatus()).to.eql(404);
    expect(N.header('Content-Type') || '').to.include('application/problem+json');
    expect(N.json().code).to.eql('not_found');
    expect(N.json()).to.not.have.property('instance');
  });
  N.status(404);
}

docs {
  Version current+1 (2 on a fresh stack) does not exist after S8.7 and S8.8.
}
