-- Records-shaped INSERT transaction (TICK-449 baseline): one record INSERT plus
-- one audit INSERT, as nava_app.
\set t random(1, 50)
\set r random(1, 20000)
BEGIN;
SELECT set_config('app.tenant_id', md5('tenant-' || :t)::uuid::text, true);
INSERT INTO records (tenant_id, id, entity_definition_id, number, version, data)
VALUES (md5('tenant-' || :t)::uuid, gen_random_uuid(), md5('def-' || :t)::uuid, :r + 1000000, 1,
        jsonb_build_object('title', 'Ticket new', 'status', :r % 5, 'priority', :r % 3, 'description', repeat('lorem ipsum ', 20)))
RETURNING id
\gset
INSERT INTO audit_log (tenant_id, id, domain, action, subject_type, subject_id, entity_definition_id, version_before, version_after,
                       actor_principal_id, source, request_id, content_sha256, diff, diff_salt, diff_sha256)
VALUES (md5('tenant-' || :t)::uuid, gen_random_uuid(), 'record', 'create', 'record', :id::uuid,
        md5('def-' || :t)::uuid, NULL, 1, md5('user-' || :r)::uuid, 'user', 'req-bench',
        '\x8a4f1c3e5b7d9f0a2c4e6a8b0d2f4a6c8e0a2c4e6a8b0d2f4a6c8e0a2c4e6a8b',
        '[{"op":"add","path":"","value":{"title":"Ticket new","status":3,"priority":1,"description":"lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum"}}]',
        '\x00112233445566778899aabbccddeeff',
        '\x1b3d5f7091b3d5f7091b3d5f7091b3d5f7091b3d5f7091b3d5f7091b3d5f7091');
COMMIT;
