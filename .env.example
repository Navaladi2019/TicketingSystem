# Sample environment for nava-core. Copy it to .env (gitignored) and edit:
#   cp .env.example .env
# `task run` loads .env when it exists; variables already set in your shell win.
# Every value below is the built-in default unless noted, so an empty or
# missing .env runs the same service. Never put real secrets in this file.

# --- HTTP server ---
NAVA_HTTP_ADDR=:8080
NAVA_HTTP_READ_HEADER_TIMEOUT=5s
NAVA_HTTP_READ_TIMEOUT=15s
NAVA_HTTP_WRITE_TIMEOUT=30s
NAVA_HTTP_IDLE_TIMEOUT=120s
# Drain budget for in-flight requests on shutdown.
NAVA_HTTP_SHUTDOWN_TIMEOUT=15s

# --- Logging ---
# debug, info, warn or error.
NAVA_LOG_LEVEL=info
# json (default) or text. text is easier to read locally.
NAVA_LOG_FORMAT=text

# --- Telemetry ---
# Flush budget for telemetry after the HTTP drain, separate from it.
NAVA_TELEMETRY_SHUTDOWN_TIMEOUT=5s

# Trace export. Leave both unset to export nothing (nothing dials out).
# Set one to send OTLP/HTTP traces, e.g. to a local Collector or Jaeger:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Read by the OTel SDK itself (see docs/architecture/nava-core-skeleton.md).
# OTEL_SERVICE_NAME=nava-core
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
